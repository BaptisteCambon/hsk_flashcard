            ? HSK1_VOCABULARY
            : HSK1_VOCABULARY.filter(w => w.category === selectedCategory);
          categoryWords.forEach(w => masteredIds.delete(w.id));
          initDeck(false);
          showToast("Mastered words shuffled back in!");
        });
      }

      const completeOpenLibBtn = document.getElementById("complete-open-lib-btn");
      if (completeOpenLibBtn) {
        completeOpenLibBtn.addEventListener("click", () => openLibrary("all"));
      }

      const openLibraryBtn = document.getElementById("open-library-btn");
      const closeLibraryBtn = document.getElementById("close-library-btn");
      const libraryModal = document.getElementById("library-modal");

      if (openLibraryBtn) openLibraryBtn.addEventListener("click", () => openLibrary("all"));
      if (closeLibraryBtn) closeLibraryBtn.addEventListener("click", closeLibrary);
      if (libraryModal) {
        libraryModal.addEventListener("click", (e) => {
          if (e.target === libraryModal) closeLibrary();
        });
      }

      const toggleImportExportBtn = document.getElementById("toggle-import-export-btn");
      const importExportPanel = document.getElementById("import-export-panel");
      if (toggleImportExportBtn && importExportPanel) {
        toggleImportExportBtn.addEventListener("click", () => {
          importExportPanel.classList.toggle("hidden");
        });
