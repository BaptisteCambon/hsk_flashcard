      if (copyExportCodeBtn) {
        copyExportCodeBtn.addEventListener("click", () => {
          const exportCodeOutput = document.getElementById("export-code-output");
          if (!exportCodeOutput || !exportCodeOutput.value) return;
          exportCodeOutput.select();
          const copied = copyTextToClipboard(exportCodeOutput.value);
          showToast(copied ? "Kicked code copied to clipboard!" : "Select and copy the code above.");
        });
      }

      const importKickedBtn = document.getElementById("import-kicked-btn");
      if (importKickedBtn) importKickedBtn.addEventListener("click", handleImportKicked);

      const tabAllBtn = document.getElementById("tab-all");
      const tabActiveBtn = document.getElementById("tab-active");
      const tabMasteredBtn = document.getElementById("tab-mastered");
      const tabKickedBtn = document.getElementById("tab-kicked");

      if (tabAllBtn) tabAllBtn.addEventListener("click", () => { activeLibraryTab = "all"; renderLibrary(); });
      if (tabActiveBtn) tabActiveBtn.addEventListener("click", () => { activeLibraryTab = "active"; renderLibrary(); });
      if (tabMasteredBtn) tabMasteredBtn.addEventListener("click", () => { activeLibraryTab = "mastered"; renderLibrary(); });
      if (tabKickedBtn) tabKickedBtn.addEventListener("click", () => { activeLibraryTab = "kicked"; renderLibrary(); });

      const librarySearchInput = document.getElementById("library-search");
      if (librarySearchInput) {
        librarySearchInput.addEventListener("input", (e) => {
          librarySearchQuery = e.target.value;
          renderLibrary();
        });
      }

      document.addEventListener("keydown", (e) => {
        const libModal = document.getElementById("library-modal");
        if (e.key === "Escape" && libModal && !libModal.classList.contains("hidden")) {
          closeLibrary();
          return;
        }
        if (libModal && !libModal.classList.contains("hidden")) return;
        if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;

        if (e.code === "Space") {
          e.preventDefault();
          flipCard();
        } else if (e.key === "1" && isFlipped) {
          e.preventDefault();
          handleStillLearning();
        } else if (e.key === "2" && isFlipped) {
          e.preventDefault();
          handleMastered();
        } else if (e.key.toLowerCase() === "x" || e.key === "Delete") {
          e.preventDefault();
          handleKickCard();
        } else if (e.key.toLowerCase() === "a") {
          e.preventDefault();
          if (studyQueue.length > 0) {
            speakMandarin(studyQueue[0].hanzi, isFlipped ? audioBtn : null);
          }
        }
      });

      // Initialize Deck on Load
      initDeck(true);
    });
  </script>
</body>
</html>
