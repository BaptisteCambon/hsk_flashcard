    const STORAGE_KEY_KICKED = "hsk1_kicked_word_ids_v1";

    function loadSavedKickedIds() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_KICKED);
        if (!raw) return new Set();
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          const validIds = new Set(HSK1_VOCABULARY.map(w => w.id));
          return new Set(parsed.map(Number).filter(id => validIds.has(id)));
        }
      } catch (e) {
        // Ignore storage access errors
      }
      return new Set();
    }

    function saveKickedIds() {
      try {
        localStorage.setItem(STORAGE_KEY_KICKED, JSON.stringify([...kickedIds]));
      } catch (e) {
        // Ignore storage quota errors
      }
    }

    let selectedCategory = "All Words";
    let studyMode = "hanzi"; // 'hanzi' | 'pinyin' | 'english'
    let studyQueue = [];
    let masteredIds = new Set();
    let reviewAgainIds = new Set();
    let kickedIds = loadSavedKickedIds();
    let isFlipped = false;
    let streak = 0;
    let totalInCategory = 0;
    let activeLibraryTab = "all";
    let librarySearchQuery = "";
    let toastTimeout = null;

    function shuffleArray(array) {
      const copy = [...array];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function showToast(message) {
      const toastMsgEl = document.getElementById("toast-msg");
      if (!toastMsgEl) return;
      toastMsgEl.textContent = message;
      toastMsgEl.classList.remove("hidden");
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastMsgEl.classList.add("hidden");
      }, 2200);
    }

    function speakMandarin(text, btnElement = null) {
      if (!("speechSynthesis" in window)) {
        showToast("Audio playback not supported.");
        return;
      }
      try {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "zh-CN";
        utterance.rate = 0.88;

        if (btnElement) {
          btnElement.classList.add("audio-speaking");
          utterance.onend = () => btnElement.classList.remove("audio-speaking");
          utterance.onerror = () => btnElement.classList.remove("audio-speaking");
        }
        window.speechSynthesis.speak(utterance);
      } catch (err) {
        showToast("Unable to play audio.");
      }
    }

    function renderCategoryPills() {
      const categoryFiltersEl = document.getElementById("category-filters");
      if (!categoryFiltersEl) return;
      categoryFiltersEl.innerHTML = "";
      CATEGORIES.forEach(cat => {
        const btn = document.createElement("button");
        btn.type = "button";
        const isActive = cat === selectedCategory;
        btn.className = isActive
          ? "px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-900 text-white shadow-xs whitespace-nowrap transition"
          : "px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200/85 hover:border-slate-300 hover:text-slate-900 whitespace-nowrap transition";
        btn.textContent = cat;
        btn.addEventListener("click", () => {
          selectedCategory = cat;
          initDeck(false);
        });
        categoryFiltersEl.appendChild(btn);
      });
    }

    function initDeck(resetProgress = false) {
      if (resetProgress) {
        masteredIds.clear();
        reviewAgainIds.clear();
      }

      const categoryWords = selectedCategory === "All Words"
        ? HSK1_VOCABULARY
        : HSK1_VOCABULARY.filter(w => w.category === selectedCategory);

      totalInCategory = categoryWords.length;

      const activeWords = categoryWords.filter(
        w => !kickedIds.has(w.id) && !masteredIds.has(w.id)
      );

      studyQueue = shuffleArray(activeWords);
      isFlipped = false;

      renderCategoryPills();
      updateStudyModeUI();
      updateStatsUI();
      renderCurrentCard();
    }

    function updateStudyModeUI() {
      const modeHanziBtn = document.getElementById("mode-hanzi-btn");
      const modePinyinBtn = document.getElementById("mode-pinyin-btn");
      const modeEnglishBtn = document.getElementById("mode-english-btn");
      const modeSubtitleEl = document.getElementById("mode-subtitle");

      const modeButtons = [
        { el: modeHanziBtn, mode: "hanzi" },
        { el: modePinyinBtn, mode: "pinyin" },
        { el: modeEnglishBtn, mode: "english" }
      ];

      modeButtons.forEach(mb => {
        if (!mb.el) return;
        if (mb.mode === studyMode) {
          mb.el.className = "px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-900 shadow-xs transition";
        } else {
          mb.el.className = "px-3 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 transition";
        }
      });

      if (modeSubtitleEl) {
        if (studyMode === "hanzi") {
          modeSubtitleEl.textContent = "150 Core Words • Hanzi Mode";
        } else if (studyMode === "pinyin") {
          modeSubtitleEl.textContent = "150 Core Words • Pinyin Mode";
        } else {
          modeSubtitleEl.textContent = "150 Core Words • English Mode";
        }
      }
    }

    function renderCurrentCard() {
      const cardWrapper = document.getElementById("card-wrapper");
      const controlsAreaEl = document.getElementById("controls-area");
      const queueIndicatorEl = document.getElementById("queue-indicator");
      const completeScreenEl = document.getElementById("complete-screen");
      const completedTotalEl = document.getElementById("completed-total");
      const flashcardInner = document.getElementById("flashcard-inner");
      const revealControls = document.getElementById("reveal-controls");
      const ratingControls = document.getElementById("rating-controls");
      const queueRemainingTextEl = document.getElementById("queue-remaining-text");
      const reviewBadgeEl = document.getElementById("review-badge");
      const frontPromptTagEl = document.getElementById("front-prompt-tag");
      const frontDisplayEl = document.getElementById("front-display");
      const frontInstructionEl = document.getElementById("front-instruction");
      const backCategoryEl = document.getElementById("back-category");
      const backHanziEl = document.getElementById("back-hanzi");
      const backPinyinEl = document.getElementById("back-pinyin");
      const backEnglishEl = document.getElementById("back-english");
      const backExZhEl = document.getElementById("back-ex-zh");
      const backExPyEl = document.getElementById("back-ex-py");
      const backExEnEl = document.getElementById("back-ex-en");

      if (studyQueue.length === 0) {
        if (cardWrapper) cardWrapper.classList.add("hidden");
        if (controlsAreaEl) controlsAreaEl.classList.add("hidden");
        if (queueIndicatorEl) queueIndicatorEl.classList.add("hidden");
        if (completeScreenEl) completeScreenEl.classList.remove("hidden");
        const activeTotal = Math.max(0, totalInCategory - kickedIds.size);
        if (completedTotalEl) completedTotalEl.textContent = activeTotal;
        return;
      }

      if (cardWrapper) cardWrapper.classList.remove("hidden");
      if (controlsAreaEl) controlsAreaEl.classList.remove("hidden");
      if (queueIndicatorEl) queueIndicatorEl.classList.remove("hidden");
      if (completeScreenEl) completeScreenEl.classList.add("hidden");

      isFlipped = false;
      if (flashcardInner) flashcardInner.classList.remove("rotate-y-180");
      if (revealControls) revealControls.classList.remove("hidden");
      if (ratingControls) ratingControls.classList.add("hidden");

      const currentWord = studyQueue[0];

      if (queueRemainingTextEl) queueRemainingTextEl.textContent = `Remaining in queue: ${studyQueue.length}`;
      if (reviewBadgeEl) {
        if (reviewAgainIds.has(currentWord.id)) {
          reviewBadgeEl.classList.remove("hidden");
        } else {
          reviewBadgeEl.classList.add("hidden");
        }
      }

      if (studyMode === "hanzi") {
        if (frontPromptTagEl) frontPromptTagEl.textContent = "Guess Pinyin & Meaning";
        if (frontDisplayEl) {
          frontDisplayEl.textContent = currentWord.hanzi;
          frontDisplayEl.className = "hanzi-font text-7xl sm:text-8xl md:text-9xl font-bold text-slate-900 tracking-wide text-center leading-tight";
        }
        if (frontInstructionEl) frontInstructionEl.textContent = "Recall the Pinyin & Meaning, then tap or press Space";
      } else if (studyMode === "pinyin") {
        if (frontPromptTagEl) frontPromptTagEl.textContent = "Guess Hanzi & Meaning";
        if (frontDisplayEl) {
          frontDisplayEl.textContent = currentWord.pinyin;
          frontDisplayEl.className = "text-4xl sm:text-5xl md:text-6xl font-bold text-rose-600 tracking-wide text-center leading-tight";
        }
        if (frontInstructionEl) frontInstructionEl.textContent = "Recall the Hanzi & English meaning, then tap or press Space";
      } else {
        if (frontPromptTagEl) frontPromptTagEl.textContent = "Guess Hanzi & Pinyin";
        if (frontDisplayEl) {
          frontDisplayEl.textContent = currentWord.english;
          frontDisplayEl.className = "text-2xl sm:text-3xl md:text-4xl font-semibold text-slate-800 tracking-tight text-center leading-snug px-4";
        }
        if (frontInstructionEl) frontInstructionEl.textContent = "Recall the Chinese Hanzi & Pinyin, then tap or press Space";
      }

      if (backCategoryEl) backCategoryEl.textContent = currentWord.category;
      if (backHanziEl) backHanziEl.textContent = currentWord.hanzi;
      if (backPinyinEl) backPinyinEl.textContent = currentWord.pinyin;
      if (backEnglishEl) backEnglishEl.textContent = currentWord.english;
      if (backExZhEl) backExZhEl.textContent = currentWord.exZh;
      if (backExPyEl) backExPyEl.textContent = currentWord.exPy;
      if (backExEnEl) backExEnEl.textContent = currentWord.exEn;
    }

    function flipCard() {
      if (studyQueue.length === 0) return;
      isFlipped = !isFlipped;
      const flashcardInner = document.getElementById("flashcard-inner");
      const revealControls = document.getElementById("reveal-controls");
      const ratingControls = document.getElementById("rating-controls");

      if (isFlipped) {
        if (flashcardInner) flashcardInner.classList.add("rotate-y-180");
        if (revealControls) revealControls.classList.add("hidden");
        if (ratingControls) ratingControls.classList.remove("hidden");
      } else {
        if (flashcardInner) flashcardInner.classList.remove("rotate-y-180");
        if (revealControls) revealControls.classList.remove("hidden");
        if (ratingControls) ratingControls.classList.add("hidden");
      }
    }

    function handleStillLearning() {
      if (studyQueue.length === 0 || !isFlipped) return;
      const currentWord = studyQueue.shift();
      reviewAgainIds.add(currentWord.id);
      streak = 0;

      const minIndex = studyQueue.length > 2 ? 2 : studyQueue.length;
      const randomIndex = minIndex + Math.floor(Math.random() * (studyQueue.length - minIndex + 1));
      studyQueue.splice(randomIndex, 0, currentWord);

      updateStatsUI();
      renderCurrentCard();
      showToast("Mixed randomly back into deck");
    }

    function handleMastered() {
      if (studyQueue.length === 0 || !isFlipped) return;
      const currentWord = studyQueue.shift();
      masteredIds.add(currentWord.id);
      reviewAgainIds.delete(currentWord.id);
      streak += 1;

      updateStatsUI();
      renderCurrentCard();
    }

    function handleKickCard() {
      if (studyQueue.length === 0) return;
      const currentWord = studyQueue.shift();
      kickedIds.add(currentWord.id);
      reviewAgainIds.delete(currentWord.id);
      masteredIds.delete(currentWord.id);
      saveKickedIds();

      updateStatsUI();
      renderCurrentCard();
      showToast(`Kicked "${currentWord.hanzi}" (saved)`);
    }

    function updateStatsUI() {
      const categoryWords = selectedCategory === "All Words"
        ? HSK1_VOCABULARY
        : HSK1_VOCABULARY.filter(w => w.category === selectedCategory);

      const categoryWordIds = new Set(categoryWords.map(w => w.id));
      const masteredInCat = [...masteredIds].filter(id => categoryWordIds.has(id)).length;
      const kickedInCat = [...kickedIds].filter(id => categoryWordIds.has(id)).length;
      const activeTotal = Math.max(0, totalInCategory - kickedInCat);

      const masteredCountEl = document.getElementById("mastered-count");
      const totalCountEl = document.getElementById("total-count");
      const streakCountEl = document.getElementById("streak-count");
      const kickedBadgeEl = document.getElementById("kicked-badge");
      const kickedCountEl = document.getElementById("kicked-count");
      const progressBarEl = document.getElementById("progress-bar");

      if (masteredCountEl) masteredCountEl.textContent = masteredInCat;
      if (totalCountEl) totalCountEl.textContent = `/${activeTotal}`;
      if (streakCountEl) streakCountEl.textContent = streak;

      if (kickedIds.size > 0) {
        if (kickedBadgeEl) kickedBadgeEl.classList.remove("hidden");
        if (kickedCountEl) kickedCountEl.textContent = kickedIds.size;
      } else {
        if (kickedBadgeEl) kickedBadgeEl.classList.add("hidden");
      }

      const pct = activeTotal > 0 ? Math.round((masteredInCat / activeTotal) * 100) : 100;
      if (progressBarEl) progressBarEl.style.width = `${pct}%`;
    }

    function openLibrary(defaultTab = "all") {
      activeLibraryTab = defaultTab;
      const libraryModal = document.getElementById("library-modal");
      if (libraryModal) libraryModal.classList.remove("hidden");
      renderLibrary();
    }

    function closeLibrary() {
      const libraryModal = document.getElementById("library-modal");
      if (libraryModal) libraryModal.classList.add("hidden");
    }

    function insertWordRandomlyIntoQueue(word) {
      if (selectedCategory !== "All Words" && word.category !== selectedCategory) return;
      if (studyQueue.some(w => w.id === word.id)) return;

      if (studyQueue.length <= 1) {
        studyQueue.push(word);
      } else {
        const pos = 1 + Math.floor(Math.random() * studyQueue.length);
        studyQueue.splice(pos, 0, word);
      }
      const queueRemainingTextEl = document.getElementById("queue-remaining-text");
      if (studyQueue.length === 1) {
        renderCurrentCard();
      } else if (queueRemainingTextEl) {
        queueRemainingTextEl.textContent = `Remaining in queue: ${studyQueue.length}`;
      }
    }

    function removeWordFromQueue(wordId) {
      const wasFirst = studyQueue.length > 0 && studyQueue[0].id === wordId;
      studyQueue = studyQueue.filter(w => w.id !== wordId);
      const queueRemainingTextEl = document.getElementById("queue-remaining-text");
      if (wasFirst || studyQueue.length === 0) {
        renderCurrentCard();
      } else if (queueRemainingTextEl) {
        queueRemainingTextEl.textContent = `Remaining in queue: ${studyQueue.length}`;
      }
    }

    function toggleKickFromLibrary(word) {
      if (kickedIds.has(word.id)) {
        kickedIds.delete(word.id);
        saveKickedIds();
        insertWordRandomlyIntoQueue(word);
        showToast(`Restored "${word.hanzi}"`);
      } else {
        kickedIds.add(word.id);
        masteredIds.delete(word.id);
        reviewAgainIds.delete(word.id);
        saveKickedIds();
        removeWordFromQueue(word.id);
        showToast(`Kicked "${word.hanzi}" (saved)`);
      }
      updateStatsUI();
      renderLibrary();
    }

    function restudyMasteredWord(word) {
      masteredIds.delete(word.id);
      kickedIds.delete(word.id);
      saveKickedIds();
      insertWordRandomlyIntoQueue(word);
      updateStatsUI();
      renderLibrary();
      showToast(`Added "${word.hanzi}" back to study queue`);
    }

    function copyTextToClipboard(text) {
      try {
        const tempInput = document.createElement("textarea");
        tempInput.value = text;
        tempInput.style.position = "fixed";
        tempInput.style.opacity = "0";
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand("copy");
        document.body.removeChild(tempInput);
        return true;
      } catch (e) {
        return false;
      }
    }

    function generateKickedExportCode() {
      const kickedList = [...kickedIds].map(id => {
        const word = HSK1_VOCABULARY.find(w => w.id === id);
        return word ? word.hanzi : id;
      });
      return JSON.stringify(kickedList, null, 2);
    }

    function parseKickedImportCode(rawText) {
      const trimmed = (rawText || "").trim();
      if (!trimmed) return new Set();

      const validIds = new Set(HSK1_VOCABULARY.map(w => w.id));
      const hanziToId = new Map(HSK1_VOCABULARY.map(w => [w.hanzi, w.id]));
      const extracted = new Set();

      // Try parsing as JSON first (array of strings/numbers or objects)
      try {
        const parsed = JSON.parse(trimmed);
        if (Array.isArray(parsed)) {
          for (const item of parsed) {
            if (typeof item === "number" && validIds.has(item)) {
              extracted.add(item);
            } else if (typeof item === "string") {
              const cleanItem = item.trim();
              if (hanziToId.has(cleanItem)) {
                extracted.add(hanziToId.get(cleanItem));
              } else {
                const num = parseInt(cleanItem, 10);
                if (!Number.isNaN(num) && validIds.has(num)) {
                  extracted.add(num);
                }
              }
            } else if (item && typeof item === "object" && item.id && validIds.has(Number(item.id))) {
              extracted.add(Number(item.id));
            }
          }
          return extracted;
        }
      } catch (e) {
        // Not valid JSON, fallback to comma/space/newline token parsing
      }

      // Fallback delimiter splitting
      const tokens = trimmed.split(/[\s,;|"'\n\r\t]+/).filter(Boolean);
      for (const token of tokens) {
        if (hanziToId.has(token)) {
          extracted.add(hanziToId.get(token));
        } else {
          const num = parseInt(token, 10);
          if (!Number.isNaN(num) && validIds.has(num)) {
            extracted.add(num);
          }
        }
      }

      return extracted;
    }

    function handleExportKicked() {
      const code = generateKickedExportCode();
      const exportCodeOutput = document.getElementById("export-code-output");
      const exportCodeBox = document.getElementById("export-code-box");
      if (exportCodeOutput) exportCodeOutput.value = code;
      if (exportCodeBox) exportCodeBox.classList.remove("hidden");
      if (exportCodeOutput) {
        exportCodeOutput.focus();
        exportCodeOutput.select();
      }
      const copied = copyTextToClipboard(code);
      showToast(copied ? `Exported JSON (${kickedIds.size} words)` : "JSON ready!");
    }

    function handleImportKicked() {
      const importCodeInput = document.getElementById("import-code-input");
      if (!importCodeInput) return;

      const parsedSet = parseKickedImportCode(importCodeInput.value);
      if (parsedSet.size === 0 && importCodeInput.value.trim() !== "") {
        showToast("Could not recognize any valid words in paste.");
        return;
      }

      kickedIds = parsedSet;
      kickedIds.forEach(id => {
        masteredIds.delete(id);
        reviewAgainIds.delete(id);
      });
      saveKickedIds();

      initDeck(false);
      renderLibrary();
      importCodeInput.value = "";
      showToast(`Imported ${kickedIds.size} kicked word${kickedIds.size === 1 ? "" : "s"}!`);
    }

    function renderLibrary() {
      const activeCount = HSK1_VOCABULARY.filter(w => !kickedIds.has(w.id) && !masteredIds.has(w.id)).length;
      
      const libCountAllEl = document.getElementById("lib-count-all");
      const libCountActiveEl = document.getElementById("lib-count-active");
      const libCountMasteredEl = document.getElementById("lib-count-mastered");
      const libCountKickedEl = document.getElementById("lib-count-kicked");

      if (libCountAllEl) libCountAllEl.textContent = HSK1_VOCABULARY.length;
      if (libCountActiveEl) libCountActiveEl.textContent = activeCount;
      if (libCountMasteredEl) libCountMasteredEl.textContent = masteredIds.size;
      if (libCountKickedEl) libCountKickedEl.textContent = kickedIds.size;

      const tabAllBtn = document.getElementById("tab-all");
      const tabActiveBtn = document.getElementById("tab-active");
      const tabMasteredBtn = document.getElementById("tab-mastered");
      const tabKickedBtn = document.getElementById("tab-kicked");

      const tabs = [
        { el: tabAllBtn, key: "all" },
        { el: tabActiveBtn, key: "active" },
        { el: tabMasteredBtn, key: "mastered" },
        { el: tabKickedBtn, key: "kicked" }
      ];

      tabs.forEach(t => {
        if (!t.el) return;
        if (t.key === activeLibraryTab) {
          t.el.className = "px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-900 shadow-xs transition";
        } else {
          t.el.className = "px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition";
        }
      });

      const libraryBulkBar = document.getElementById("library-bulk-bar");
      const bulkBarText = document.getElementById("bulk-bar-text");
      const bulkActionBtn = document.getElementById("bulk-action-btn");

      if (activeLibraryTab === "mastered" && masteredIds.size > 0) {
        if (libraryBulkBar) {
          libraryBulkBar.classList.remove("hidden");
          libraryBulkBar.className = "px-5 py-2.5 bg-emerald-50/80 border-b border-emerald-200/60 flex items-center justify-between gap-2";
        }
        if (bulkBarText) {
          bulkBarText.className = "text-xs font-medium text-emerald-900";
          bulkBarText.textContent = `You have ${masteredIds.size} mastered word${masteredIds.size === 1 ? "" : "s"}.`;
        }
        if (bulkActionBtn) {
          bulkActionBtn.className = "px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition shadow-xs";
          bulkActionBtn.textContent = "Study All Mastered Again";
          bulkActionBtn.onclick = () => {
            const wordsToRestore = HSK1_VOCABULARY.filter(w => masteredIds.has(w.id));
            masteredIds.clear();
            wordsToRestore.forEach(w => insertWordRandomlyIntoQueue(w));
            studyQueue = shuffleArray(studyQueue);
            updateStatsUI();
            renderCurrentCard();
            renderLibrary();
            showToast("All mastered words shuffled back in!");
          };
        }
      } else if (activeLibraryTab === "kicked" && kickedIds.size > 0) {
        if (libraryBulkBar) {
          libraryBulkBar.classList.remove("hidden");
          libraryBulkBar.className = "px-5 py-2.5 bg-slate-100 border-b border-slate-200/80 flex items-center justify-between gap-2";
        }
        if (bulkBarText) {
          bulkBarText.className = "text-xs font-medium text-slate-700";
          bulkBarText.textContent = `${kickedIds.size} word${kickedIds.size === 1 ? "" : "s"} currently kicked.`;
        }
        if (bulkActionBtn) {
          bulkActionBtn.className = "px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold transition shadow-xs";
          bulkActionBtn.textContent = "Restore All Kicked";
          bulkActionBtn.onclick = () => {
            const wordsToRestore = HSK1_VOCABULARY.filter(w => kickedIds.has(w.id));
            kickedIds.clear();
            saveKickedIds();
            wordsToRestore.forEach(w => insertWordRandomlyIntoQueue(w));
            studyQueue = shuffleArray(studyQueue);
            updateStatsUI();
            renderCurrentCard();
            renderLibrary();
            showToast("Restored all kicked words!");
          };
        }
      } else {
        if (libraryBulkBar) libraryBulkBar.classList.add("hidden");
      }

      const q = librarySearchQuery.trim().toLowerCase();
      const filtered = HSK1_VOCABULARY.filter(w => {
        if (activeLibraryTab === "active" && (kickedIds.has(w.id) || masteredIds.has(w.id))) return false;
        if (activeLibraryTab === "mastered" && !masteredIds.has(w.id)) return false;
        if (activeLibraryTab === "kicked" && !kickedIds.has(w.id)) return false;
        if (!q) return true;
        return (
          w.hanzi.includes(q) ||
          w.pinyin.toLowerCase().includes(q) ||
          w.english.toLowerCase().includes(q) ||
          w.category.toLowerCase().includes(q)
        );
      });

      const libraryListEl = document.getElementById("library-list");
      if (!libraryListEl) return;

      if (filtered.length === 0) {
        libraryListEl.innerHTML = `
          <div class="py-12 text-center text-sm text-slate-400">
            No words found in this view.
          </div>
        `;
        return;
      }

      libraryListEl.innerHTML = "";
      filtered.forEach(word => {
        const isKicked = kickedIds.has(word.id);
        const isMastered = masteredIds.has(word.id);

        const row = document.createElement("div");
        row.className = `py-2.5 px-2 flex items-center justify-between gap-3 rounded-xl transition ${
          isKicked ? "opacity-60 bg-slate-50/70" : "hover:bg-slate-50"
        }`;

        const left = document.createElement("div");
        left.className = "flex items-center gap-3 min-w-0";

        const playBtn = document.createElement("button");
        playBtn.type = "button";
        playBtn.className = "w-8 h-8 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center shrink-0 transition";
        playBtn.title = "Listen";
        playBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>`;
        playBtn.addEventListener("click", () => speakMandarin(word.hanzi));

        const info = document.createElement("div");
        info.className = "min-w-0";
        info.innerHTML = `
          <div class="flex items-baseline gap-2 flex-wrap">
            <span class="hanzi-font text-lg font-bold text-slate-900 ${isKicked ? "line-through text-slate-400" : ""}">${word.hanzi}</span>
            <span class="text-xs font-semibold text-rose-600">${word.pinyin}</span>
            ${isMastered ? '<span class="text-[10px] font-semibold bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded">Mastered</span>' : ""}
            ${isKicked ? '<span class="text-[10px] font-semibold bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded">Kicked</span>' : ""}
          </div>
          <p class="text-xs text-slate-500 truncate">${word.english} <span class="text-slate-300">•</span> <span class="text-[11px] text-slate-400">${word.category}</span></p>
        `;

        left.appendChild(playBtn);
        left.appendChild(info);

        const actions = document.createElement("div");
        actions.className = "flex items-center gap-1.5 shrink-0";

        if (isMastered) {
          const restudyBtn = document.createElement("button");
          restudyBtn.type = "button";
          restudyBtn.className = "px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200/80 transition";
          restudyBtn.textContent = "Study Again";
          restudyBtn.addEventListener("click", () => restudyMasteredWord(word));
          actions.appendChild(restudyBtn);
        }

        const kickToggleBtn = document.createElement("button");
        kickToggleBtn.type = "button";
        if (isKicked) {
          kickToggleBtn.className = "px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-white hover:bg-slate-900 transition";
          kickToggleBtn.textContent = "Restore";
        } else {
          kickToggleBtn.className = "px-2.5 py-1.5 rounded-lg text-xs font-medium bg-white text-slate-600 hover:text-rose-600 hover:border-rose-200 border border-slate-200 transition";
          kickToggleBtn.textContent = "Kick";
        }
        kickToggleBtn.addEventListener("click", () => toggleKickFromLibrary(word));
        actions.appendChild(kickToggleBtn);

        row.appendChild(left);
        row.appendChild(actions);
        libraryListEl.appendChild(row);
      });
    }

    // Attach all event listeners safely on DOMContentLoaded
    document.addEventListener("DOMContentLoaded", () => {
      const cardWrapper = document.getElementById("card-wrapper");
      if (cardWrapper) {
        cardWrapper.addEventListener("click", (e) => {
          if (e.target.closest("button")) return;
          flipCard();
        });
