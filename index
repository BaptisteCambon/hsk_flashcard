      if (modeHanziBtn) {
        modeHanziBtn.addEventListener("click", () => {
          studyMode = "hanzi";
          initDeck(false);
        });
      }
      if (modePinyinBtn) {
        modePinyinBtn.addEventListener("click", () => {
          studyMode = "pinyin";
          initDeck(false);
        });
      }
      if (modeEnglishBtn) {
        modeEnglishBtn.addEventListener("click", () => {
          studyMode = "english";
          initDeck(false);
        });
