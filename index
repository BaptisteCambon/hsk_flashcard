<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HSK 1 Active Recall Flashcards</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
      -webkit-tap-highlight-color: transparent;
    }
    .hanzi-font {
      font-family: 'Noto Sans SC', sans-serif;
    }
    .perspective-1000 {
      perspective: 1200px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
      transition: transform 0.55s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes pulseRing {
      0% { transform: scale(0.95); opacity: 0.7; }
      70% { transform: scale(1.25); opacity: 0; }
      100% { transform: scale(1.25); opacity: 0; }
    }
    .audio-speaking::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      border: 2px solid #dc2626;
      animation: pulseRing 1.1s infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-rose-100 selection:text-rose-900">

  <!-- Top Navigation & Stats Header -->
  <header class="w-full max-w-4xl mx-auto px-4 pt-5 pb-3">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-rose-600 text-white flex items-center justify-center font-bold hanzi-font text-lg shadow-sm">
          汉
        </div>
        <div>
          <h1 class="text-lg font-bold tracking-tight text-slate-900 leading-tight">HSK 1 Active Recall</h1>
          <p id="mode-subtitle" class="text-xs text-slate-500">150 Core Words • Hanzi Mode</p>
        </div>
      </div>

      <!-- Session Metrics -->
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="bg-white border border-slate-200/80 rounded-xl px-3 py-1.5 shadow-xs flex items-center gap-2" title="Consecutive Mastered Streak">
          <span class="text-amber-500 text-sm">🔥</span>
          <div class="text-xs">
            <span class="text-slate-400 font-medium">Streak</span>
            <span id="streak-count" class="font-bold text-slate-800 ml-1">0</span>
          </div>
        </div>

        <div class="bg-white border border-slate-200/80 rounded-xl px-3 py-1.5 shadow-xs flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <div class="text-xs">
            <span class="text-slate-400 font-medium">Mastered</span>
            <span id="mastered-count" class="font-bold text-slate-800 ml-1">0</span><span id="total-count" class="text-slate-400">/150</span>
          </div>
        </div>

        <div id="kicked-badge" class="hidden bg-white border border-slate-200/80 rounded-xl px-3 py-1.5 shadow-xs flex items-center gap-1.5" title="Kicked from current study queue">
          <span class="text-slate-400 text-xs">🚫</span>
          <div class="text-xs">
            <span class="text-slate-400 font-medium">Kicked</span>
            <span id="kicked-count" class="font-bold text-slate-700 ml-0.5">0</span>
          </div>
        </div>

        <button id="open-library-btn" type="button" class="px-3 py-1.5 rounded-xl bg-white border border-slate-200/80 text-slate-700 hover:text-rose-600 hover:border-rose-200 transition shadow-xs flex items-center gap-1.5 text-xs font-semibold" title="Manage Word Library & Mastered Words">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Word Library</span>
        </button>

        <button id="reset-session-btn" type="button" class="p-2 rounded-xl bg-white border border-slate-200/80 text-slate-600 hover:text-rose-600 hover:border-rose-200 transition shadow-xs" title="Shuffle Active Queue">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="w-full bg-slate-200/80 h-2 rounded-full overflow-hidden mb-4">
      <div id="progress-bar" class="bg-emerald-500 h-full rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
    </div>

    <!-- Topic Filter Pills & Study Mode Switcher -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <div id="category-filters" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 flex-1">
        <!-- Populated dynamically by JS -->
      </div>

      <div class="flex items-center gap-1 bg-slate-200/70 p-1 rounded-2xl shrink-0 self-start sm:self-auto">
        <button id="mode-hanzi-btn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-slate-900 shadow-xs transition" title="Show Hanzi, guess Pinyin &amp; Meaning">
          🈴 Hanzi Mode
        </button>
        <button id="mode-pinyin-btn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 transition" title="Show Pinyin, guess Hanzi &amp; Meaning">
          🔤 Pinyin Mode
        </button>
        <button id="mode-english-btn" type="button" class="px-3 py-1.5 rounded-xl text-xs font-medium text-slate-600 hover:text-slate-900 transition" title="Show Meaning, guess Hanzi &amp; Pinyin">
          🇬🇧 English Mode
        </button>
      </div>
    </div>
  </header>

  <!-- Main Flashcard Stage -->
  <main class="flex-1 flex flex-col items-center justify-center w-full max-w-2xl mx-auto px-4 py-2">
    
    <div id="queue-indicator" class="mb-3 flex items-center gap-2 text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full">
      <span id="queue-remaining-text">Remaining in queue: 150</span>
      <span id="review-badge" class="hidden bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full text-[11px] font-semibold">Reviewing Again</span>
    </div>

    <!-- 3D Card Container -->
    <div id="card-wrapper" class="w-full perspective-1000 h-[370px] sm:h-[410px] cursor-pointer select-none">
      <div id="flashcard-inner" class="relative w-full h-full transform-style-3d">
        
        <!-- FRONT OF CARD -->
        <div class="absolute inset-0 backface-hidden bg-white rounded-3xl border border-slate-200/90 shadow-lg shadow-slate-200/50 flex flex-col items-center justify-center p-6">
          <div class="flex-1 flex flex-col items-center justify-center w-full text-center">
            <span id="front-prompt-tag" class="text-xs font-bold uppercase tracking-wider text-rose-600 bg-rose-50 px-3 py-1 rounded-full mb-3">
              Guess Hanzi &amp; Meaning
            </span>
            <span id="front-display" class="hanzi-font text-6xl sm:text-7xl md:text-8xl font-bold text-slate-900 tracking-wide leading-tight">
              你好
            </span>
          </div>
          <p id="front-instruction" class="text-xs text-slate-400 font-medium tracking-wide">
            Recall the prompt, then tap or press Space
          </p>
        </div>

        <!-- BACK OF CARD -->
        <div class="absolute inset-0 backface-hidden rotate-y-180 bg-white rounded-3xl border border-slate-200/90 shadow-lg shadow-slate-200/50 flex flex-col justify-between p-6 sm:p-8 overflow-y-auto">
          
          <div class="flex items-center justify-between w-full">
            <span id="back-category" class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 bg-slate-100 px-2.5 py-1 rounded-lg">
              Pronouns &amp; People
            </span>
            <button id="audio-btn" type="button" class="relative flex items-center gap-2 px-3.5 py-2 rounded-full bg-rose-50 text-rose-600 hover:bg-rose-100 active:scale-95 transition font-medium text-xs border border-rose-200/70" title="Listen (Shortcut: A)">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
              </svg>
              <span>Listen</span>
            </button>
          </div>

          <div class="text-center my-3">
            <div id="back-hanzi" class="hanzi-font text-4xl sm:text-5xl font-bold text-slate-900 mb-1.5">
              你好
            </div>
            <div id="back-pinyin" class="text-xl sm:text-2xl font-semibold text-rose-600 tracking-wide mb-1">
              nǐ hǎo
            </div>
            <div id="back-english" class="text-base sm:text-lg font-medium text-slate-700">
              hello; hi
            </div>
          </div>

          <div class="bg-slate-50 border border-slate-200/70 rounded-2xl p-4 text-left relative">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Example in Context</span>
              <button id="example-audio-btn" type="button" class="text-slate-400 hover:text-rose-600 transition p-1 rounded-lg" title="Play Example Sentence">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </button>
            </div>
            <p id="back-ex-zh" class="hanzi-font text-base sm:text-lg font-medium text-slate-900 leading-snug">
              你好，很高兴认识你。
            </p>
            <p id="back-ex-py" class="text-xs sm:text-sm text-rose-600/90 mt-0.5">
              Nǐ hǎo, hěn gāoxìng rènshi nǐ.
            </p>
            <p id="back-ex-en" class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Hello, nice to meet you.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Session Complete Screen -->
    <div id="complete-screen" class="hidden w-full bg-white rounded-3xl border border-slate-200 shadow-lg p-8 text-center">
      <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">
        🎉
      </div>
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Deck Completed!</h2>
      <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">
        Great job! You have mastered all <span id="completed-total" class="font-semibold text-slate-800">150</span> active words in this category. You can practice mastered words again or manage your kicked list in the Word Library.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button id="restart-completed-btn" type="button" class="px-6 py-3 rounded-2xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm shadow-sm transition active:scale-95">
          Practice Mastered Again
        </button>
        <button id="complete-open-lib-btn" type="button" class="px-5 py-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-sm transition active:scale-95">
          Open Word Library
        </button>
      </div>
    </div>

    <!-- Action Controls Below Card -->
    <div id="controls-area" class="w-full mt-5">
      <div id="reveal-controls" class="flex flex-col sm:flex-row items-center justify-center gap-2.5">
        <button id="reveal-btn" type="button" class="w-full sm:w-72 py-3.5 px-6 rounded-2xl bg-slate-900 hover:bg-slate-800 active:scale-[0.98] text-white font-semibold text-base shadow-md shadow-slate-900/10 transition flex items-center justify-center gap-2">
          <span>Reveal Answer</span>
          <kbd class="hidden sm:inline-block text-[11px] font-normal bg-slate-700 text-slate-200 px-2 py-0.5 rounded-md">Space</kbd>
        </button>
        <button id="kick-front-btn" type="button" class="w-full sm:w-auto py-3.5 px-4 rounded-2xl bg-white hover:bg-slate-100 active:scale-[0.98] text-slate-500 hover:text-slate-800 border border-slate-200/90 font-medium text-sm transition flex items-center justify-center gap-1.5 shadow-xs" title="Remove from learning list for now (Shortcut: X)">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
          <span>Kick</span>
          <kbd class="hidden sm:inline-block text-[10px] font-normal bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded">X</kbd>
        </button>
      </div>

      <div id="rating-controls" class="hidden grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 max-w-xl mx-auto">
        <button id="learning-btn" type="button" class="py-3.5 px-4 rounded-2xl bg-amber-50 hover:bg-amber-100 active:scale-[0.98] text-amber-900 border border-amber-200/90 font-semibold text-sm transition flex flex-col items-center justify-center shadow-xs">
          <div class="flex items-center gap-1.5">
            <span>Still Learning</span>
            <kbd class="hidden sm:inline-block text-[11px] font-normal bg-amber-200/70 text-amber-900 px-1.5 py-0.5 rounded">1</kbd>
          </div>
          <span class="text-[11px] font-normal text-amber-700 mt-0.5">Review again soon</span>
        </button>

        <button id="mastered-btn" type="button" class="py-3.5 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-semibold text-sm transition flex flex-col items-center justify-center shadow-md shadow-emerald-600/15">
          <div class="flex items-center gap-1.5">
            <span>Mastered</span>
            <kbd class="hidden sm:inline-block text-[11px] font-normal bg-emerald-700 text-emerald-100 px-1.5 py-0.5 rounded">2</kbd>
          </div>
          <span class="text-[11px] font-normal text-emerald-100 mt-0.5">Complete for session</span>
        </button>

        <button id="kick-back-btn" type="button" class="py-3.5 px-4 rounded-2xl bg-white hover:bg-slate-100 active:scale-[0.98] text-slate-600 hover:text-slate-900 border border-slate-200/90 font-semibold text-sm transition flex flex-col items-center justify-center shadow-xs">
          <div class="flex items-center gap-1.5">
            <span>Kick Card</span>
            <kbd class="hidden sm:inline-block text-[11px] font-normal bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded">X</kbd>
          </div>
          <span class="text-[11px] font-normal text-slate-400 mt-0.5">Skip for now</span>
        </button>
      </div>
    </div>

  </main>

  <footer class="w-full max-w-4xl mx-auto px-4 py-4 text-center">
    <div id="toast-msg" class="hidden inline-block mb-2 px-3 py-1 rounded-full bg-slate-800 text-white text-xs font-medium shadow-sm transition-opacity"></div>
    <div class="hidden sm:flex items-center justify-center gap-5 text-xs text-slate-400">
      <span><kbd class="font-sans bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded">Space</kbd> Flip Card</span>
      <span><kbd class="font-sans bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded">A</kbd> Pronounce</span>
      <span><kbd class="font-sans bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded">1</kbd> Still Learning</span>
      <span><kbd class="font-sans bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded">2</kbd> Mastered</span>
      <span><kbd class="font-sans bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded">X</kbd> Kick Card</span>
    </div>
  </footer>

  <!-- Word Library & Mastered Words Modal -->
  <div id="library-modal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5">
    <div class="bg-white w-full max-w-3xl max-h-[88vh] rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden">
      
      <div class="px-5 py-4 border-b border-slate-200/80 flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Word Library</h2>
          <p class="text-xs text-slate-500">Kick words you already know or re-study mastered words</p>
        </div>
        <div class="flex items-center gap-2">
          <button id="toggle-import-export-btn" type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-700 hover:text-rose-600 border border-slate-200/80 text-xs font-semibold transition flex items-center gap-1.5" title="Export or Import Kicked List Code">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            <span>Import / Export Kicked</span>
          </button>
          <button id="close-library-btn" type="button" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition" title="Close Library">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div id="import-export-panel" class="hidden px-5 py-3.5 bg-amber-50/70 border-b border-amber-200/80 space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h3 class="text-xs font-bold text-slate-800">Backup or Transfer Kicked Words</h3>
            <p class="text-[11px] text-slate-500">Copy the JSON text below or paste a saved JSON list to restore your kicked words.</p>
          </div>
          <button id="export-kicked-btn" type="button" class="px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition shrink-0 shadow-xs">
            Generate Kicked JSON
          </button>
        </div>

        <div id="export-code-box" class="hidden space-y-2">
          <textarea id="export-code-output" rows="3" readonly class="w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-xl text-slate-700 select-all focus:outline-none"></textarea>
          <button id="copy-export-code-btn" type="button" class="w-full py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition shadow-xs">
            Copy JSON to Clipboard
          </button>
        </div>

        <div class="space-y-2 pt-1 border-t border-amber-200/60">
          <label for="import-code-input" class="block text-[11px] font-semibold text-slate-700">Paste Kicked JSON or comma-separated characters below:</label>
          <textarea id="import-code-input" rows="3" placeholder='Paste here (e.g., ["我", "你"] or 1, 2, 3)...' class="w-full px-3 py-2 text-xs font-mono bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-rose-400"></textarea>
          <button id="import-kicked-btn" type="button" class="w-full py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition shadow-xs">
            Import Kicked List
          </button>
        </div>
      </div>

      <div class="px-5 pt-3 pb-3 bg-slate-50/70 border-b border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-1 bg-slate-200/70 p-1 rounded-xl self-start flex-wrap">
          <button id="tab-all" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-900 shadow-xs transition">
            All (<span id="lib-count-all">150</span>)
          </button>
          <button id="tab-active" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition">
            Active (<span id="lib-count-active">150</span>)
          </button>
          <button id="tab-mastered" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition">
            Mastered (<span id="lib-count-mastered">0</span>)
          </button>
          <button id="tab-kicked" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 transition">
            Kicked (<span id="lib-count-kicked">0</span>)
          </button>
        </div>

        <div class="relative flex-1 sm:max-w-xs">
          <input id="library-search" type="text" placeholder="Search Hanzi, Pinyin, English..." class="w-full pl-8 pr-3 py-1.5 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-rose-400" />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
