      const kickFrontBtn = document.getElementById("kick-front-btn");
      const learningBtn = document.getElementById("learning-btn");
      const masteredBtn = document.getElementById("mastered-btn");
      const kickBackBtn = document.getElementById("kick-back-btn");

      if (revealBtn) revealBtn.addEventListener("click", flipCard);
      if (kickFrontBtn) kickFrontBtn.addEventListener("click", handleKickCard);
      if (learningBtn) learningBtn.addEventListener("click", handleStillLearning);
      if (masteredBtn) masteredBtn.addEventListener("click", handleMastered);
      if (kickBackBtn) kickBackBtn.addEventListener("click", handleKickCard);

      const audioBtn = document.getElementById("audio-btn");
      if (audioBtn) {
